---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Jesús Manjarrez — Software Engineer',
  description = 'Portfolio of Jesús Manjarrez, software engineer of calm, reliable systems.',
} = Astro.props;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%232f6b3e'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='18' text-anchor='middle' fill='%23f7f1e6'%3EJ%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={favicon} />
    <meta name="theme-color" content="#f9f4eb" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vollkorn:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Fragment+Mono&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
      (function(){
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme = stored === 'dark' || stored === 'light'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
      (function(){
        var stored = null;
        try { stored = localStorage.getItem('lang'); } catch (e) {}
        var lang = (stored === 'en' || stored === 'es')
          ? stored
          : ((navigator.language || '').toLowerCase().startsWith('es') ? 'es' : 'en');
        document.documentElement.setAttribute('lang', lang);
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip" href="#main" data-i18n="skip">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/lang.ts"></script>
    <script src="../scripts/menu.ts"></script>
    <script src="../scripts/hide.ts"></script>
  </body>
</html>
