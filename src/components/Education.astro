---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="wrap">
    <div class="section__head reveal">
      <p class="mono caps" style="margin:0" data-i18n="edu.label">02 — Education</p>
      <h2 id="education-title" data-i18n="edu.title">Complementary education</h2>
      <span class="section__rule" aria-hidden="true"></span>
    </div>

    <ul class="edu__grid reveal" style="--i:1">
      {certificates.map((cert, i) => (
        <li class="edu__card">
          <a href={cert.href} target="_blank" rel="noopener noreferrer">
            <img
              src={cert.img}
              alt={`Boot.dev ${cert.title} certificate`}
              loading="lazy"
              width="450"
              height="340"
            />
            <span class="edu__meta">
              <span class="edu__no">{String(i + 1).padStart(2, '0')}</span>
              <span class="edu__name">{cert.title}</span>
              <span class="edu__src">boot.dev ↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
